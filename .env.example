# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_LOG_DIR=./logs
# 是否启用 Gateway API/MCP 认证；公网或生产环境必须保持 true
GATEWAY_AUTH_ENABLED=true
GATEWAY_API_KEY=
GATEWAY_ALLOW_INSECURE_LOCAL=true
GATEWAY_DATABASE_PATH=./data/workspace-gateway.db
# PostgreSQL 正式运行数据库；密码中的特殊字符需要 URL 编码。
GATEWAY_DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5432/workspace_gateway
# Workspace 代码同步进 Sandbox 后的远端执行目录
GATEWAY_SANDBOX_CODE_DIR=/workspace
# 持久化 Workspace 项目代码的 Git 仓库根目录；生产环境需挂载持久卷
GATEWAY_WORKSPACE_STORAGE_PATH=./data/workspaces

# Provider 连接配置不放在 .env；请在管理后台保存到数据库。
